    {
      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-8822-1",
        "name": "USN-8822-1",
        "description": "It was discovered that Libwebsockets incorrectly handled certain SSH protocol messages in its SSH protocol handler. A remote attacker could possibly use this issue to cause Libwebsockets to consume excessive resources, resulting in a denial of service. (CVE-2026-10650)  It was discovered that Libwebsockets incorrectly handled certain malformed CBOR data. A remote attacker could possibly use this issue to cause Libwebsockets to crash, resulting in a denial of service, or execute arbitrary code. This issue only affected Ubuntu 24.04 LTS and Ubuntu 26.04 LTS. (CVE-2026-78161)",
        "aliases": [
          "CVE-2026-10650",
          "CVE-2026-78161"
        ]
      },
      "timestamp": "2026-09-25T02:39:11Z",
