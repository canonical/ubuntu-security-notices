      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-7954-1",
        "name": "USN-7954-1",
        "description": "It was discovered that Libtasn1 incorrectly handled decoding ASN.1 content. An attacker could possibly use this issue to cause Libtasn1 to crash, resulting in a denial of service. (CVE-2025-13151)  It was discovered that Libtasn1 incorrectly handled encoding ASN.1 content. An attacker could possibly use this issue to cause Libtasn1 to crash, resulting in a denial of service. This issue only affected Ubuntu 22.04 LTS. (CVE-2021-46848)",
        "aliases": [
          "CVE-2021-46848",
          "CVE-2025-13151"
        ]
      },
