      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-8532-1",
        "name": "USN-8532-1",
        "description": "It was discovered that libssh2 incorrectly handled certain publickey subsystem attributes. A remote attacker controlling a malicious SSH server could use this issue to cause a denial of service or possibly execute arbitrary code. (CVE-2026-58050)  It was discovered that libssh2 did not properly initialize publickey list entries before parsing. A remote attacker controlling a malicious SSH server could use this issue to cause a denial of service or possibly execute arbitrary code. (CVE-2026-58051)",
        "aliases": [
          "CVE-2026-58050",
          "CVE-2026-58051"
        ]
      },
