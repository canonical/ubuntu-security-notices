      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-5747-1",
        "name": "USN-5747-1",
        "description": "It was discovered that Bind incorrectly handled large query name when using lightweight resolver protocol. A remote attacker could use this issue to consume resources, leading to a denial of service. (CVE-2016-2775)  It was discovered that Bind incorrectly handled large zone data size received via AXFR response. A remote authenticated attacker could use this issue to consume resources, leading to a denial of service. This issue only affected Ubuntu 16.04 LTS. (CVE-2016-6170)",
        "aliases": [
          "CVE-2016-2775",
          "CVE-2016-6170"
        ]
      },
