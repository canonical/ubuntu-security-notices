    {
      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-9138-1",
        "name": "USN-9138-1",
        "description": "It was discovered that FontForge incorrectly handled memory when reading SFD files, leading to a use-after-free. If a user or automated system were tricked into opening a specially crafted SFD file, an attacker could possibly use this issue to cause FontForge to crash, resulting in a denial of service, or possibly execute arbitrary code. (CVE-2020-5395)  It was discovered that FontForge incorrectly handled certain SFD files, leading to a heap-based buffer overflow. If a user or automated system were tricked into opening a specially crafted SFD file, an attacker could possibly use this issue to cause FontForge to crash, resulting in a denial of service, or possibly execute arbitrary code. (CVE-2020-5496)",
        "aliases": [
          "CVE-2020-5395",
          "CVE-2020-5496"
        ]
      },
      "timestamp": "2026-11-17T17:06:33Z",
