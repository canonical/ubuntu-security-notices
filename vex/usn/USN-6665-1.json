      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-6665-1",
        "name": "USN-6665-1",
        "description": "Elias Heftrig, Haya Schulmann, Niklas Vogel, and Michael Waidner discovered that Unbound incorrectly handled validating DNSSEC messages. A remote attacker could possibly use this issue to cause Unbound to consume resources, leading to a denial of service. (CVE-2023-50387)  It was discovered that Unbound incorrectly handled preparing an NSEC3 closest encloser proof. A remote attacker could possibly use this issue to cause Unbound to consume resources, leading to a denial of service. (CVE-2023-50868)",
        "aliases": [
          "CVE-2023-50387",
          "CVE-2023-50868"
        ]
      },
