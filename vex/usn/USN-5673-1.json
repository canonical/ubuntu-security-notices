    {
      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-5673-1",
        "name": "USN-5673-1",
        "description": "It was discovered that unzip did not properly handle unicode strings under certain circumstances. If a user were tricked into opening a specially crafted zip file, an attacker could possibly use this issue to cause unzip to crash, resulting in a denial of service, or possibly execute arbitrary code.  (CVE-2021-4217)  It was discovered that unzip did not properly perform bounds checking while converting wide strings to local strings. If a user were tricked into opening a specially crafted zip file, an attacker could possibly use this issue to cause unzip to crash, resulting in a denial of service, or possibly execute arbitrary code. (CVE-2022-0529, CVE-2022-0530)",
        "aliases": [
          "CVE-2021-4217",
          "CVE-2022-0529",
          "CVE-2022-0530"
        ]
      },
