      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-8319-1",
        "name": "USN-8319-1",
        "description": "It was discovered that Libgcrypt incorrectly handled crafted ECDH ciphertext. An attacker could possibly use this issue to cause Libgcrypt to crash, resulting in a denial of service. (CVE-2026-41989)  It was discovered that Libgcrypt incorrectly handled Dilithium signing. An attacker could possibly use this issue to cause Libgcrypt to crash, resulting in a denial of service. This issue only affected Ubuntu 26.04 LTS. (CVE-2026-41990)",
        "aliases": [
          "CVE-2026-41989",
          "CVE-2026-41990"
        ]
      },
