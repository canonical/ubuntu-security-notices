      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-4055-1",
        "name": "USN-4055-1",
        "description": "Mike Salvatore discovered that FlightCrew improperly handled certain malformed EPUB files. An attacker could potentially use this vulnerability to cause a denial of service. (CVE-2019-13032)  Mike Salvatore discovered that FlightCrew mishandled certain malformed EPUB files. An attacker could use this vulnerability to write arbitrary files to the filesystem. (CVE-2019-13241)  Mike Salvatore discovered that the version of Zipios included in FlightCrew mishandled certain malformed ZIP files. An attacker could use this vulnerability to cause a denial of service or consume system resources. (CVE-2019-13453)",
        "aliases": [
          "CVE-2019-13032",
          "CVE-2019-13241",
          "CVE-2019-13453"
        ]
      },
