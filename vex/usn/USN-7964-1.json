      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-7964-1",
        "name": "USN-7964-1",
        "description": "It was discovered that Git did not properly sanitize URLs when asking for credentials via a terminal prompt. An attacker could possibly use this issue to trick a user into disclosing their password. (CVE-2024-50349)  It was discovered that Git did not properly handle carriage return characters in its credential protocol. An attacker could use this issue to send unexpected data to credential helpers, possibly leading to a user being tricked into disclosing sensitive information. (CVE-2024-52006)",
        "aliases": [
          "CVE-2024-50349",
          "CVE-2024-52006"
        ]
      },
      "timestamp": "2026-01-15T14:51:12Z",
