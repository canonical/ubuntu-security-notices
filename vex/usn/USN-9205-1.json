      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-9205-1",
        "name": "USN-9205-1",
        "description": "Ariel Sch\u00f6n discovered that LibTIFF did not correctly handle parsing certain PixarLog-compressed images. If a user or automated system were tricked into opening a specially crafted file, an attacker could possibly use this issue to cause a denial of service or execute arbitrary code. (CVE-2026-12912)  Quang Luong discovered that LibTIFF did not correctly handle parsing certain TIFF files. If a user or automated system were tricked into opening a specially crafted file, an attacker could possibly use this issue to cause a denial of service or execute arbitrary code. (CVE-2026-4775)",
        "aliases": [
          "CVE-2026-4775",
          "CVE-2026-12912"
        ]
      },
