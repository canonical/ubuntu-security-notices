      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-8926-1",
        "name": "USN-8926-1",
        "description": "Yu-Fu Fu, Seth Larson and Yonatan Magier discovered that urllib3 did not correctly handle certain certificate validations. An attacker could possibly use this issue to observe or modify forwarded traffic. This issue only affected Ubuntu 26.04 LTS. (CVE-2026-97687)  Martin Desrumaux discovered that urllib3 did not correctly handle decoding certain deflate responses. An attacker could possibly use this issue to cause a denial of service. This issue only affected Ubuntu 26.04 LTS. (CVE-2026-97688)  It was discovered that urllib3 did not correctly handle certain memory operations. An attacker could possibly use this issue to cause a denial of service. (CVE-2026-97689)",
        "aliases": [
          "CVE-2026-97687",
          "CVE-2026-97688",
          "CVE-2026-97689"
        ]
      },
