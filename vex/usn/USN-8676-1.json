    {
      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-8676-1",
        "name": "USN-8676-1",
        "description": "It was discovered that the JSSE component of OpenJDK 17 did not correctly authenticate users. A remote attacker could possibly use this issue to read or modify sensitive data. (CVE-2026-46968)  It was discovered that the JSSE component of OpenJDK 17 did not correctly authorize users. A remote attacker could possibly use this issue to cause a denial of service. (CVE-2026-46917)  It was discovered that the ImageIO component of OpenJDK 17 did not correctly authorize users. A remote attacker could possibly use this issue to read or modify sensitive data. (CVE-2026-47010)  It was discovered that the 2D component of OpenJDK 17 did not correctly authorize users. A remote attacker could possibly use this issue to cause a denial of service. (CVE-2026-47021, CVE-2026-47059)  It was discovered that the Libraries component of OpenJDK 17 did not correctly authorize users. A remote attacker could possibly use this issue to cause a denial of service. (CVE-2026-47027)  It was discovered that the Security component of OpenJDK 17 did not correctly authenticate users. A remote attacker could possibly use this issue to read or modify sensitive data. (CVE-2026-60147)  It was discovered that the Libraries component of OpenJDK 17 did not correctly authenticate users. A remote attacker could possibly use this issue to read or modify sensitive data. (CVE-2026-47063)  It was discovered that the 2D (Little CMS) component of OpenJDK 17 did not correctly handle certain integer arithmetic. An attacker could possibly use this issue to cause a denial of service. (CVE-2026-41254)  In addition to security fixes, the updated packages contain bug fixes, new features, and possibly incompatible changes.  Please see the following for more information: https://openjdk.org/groups/vulnerability/advisories/2026-07-21",
        "aliases": [
          "CVE-2026-41254",
          "CVE-2026-46917",
          "CVE-2026-46968",
          "CVE-2026-47010",
          "CVE-2026-47021",
          "CVE-2026-47027",
          "CVE-2026-47059",
          "CVE-2026-47063",
          "CVE-2026-60147"
        ]
      },
