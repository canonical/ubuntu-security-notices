      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-8582-1",
        "name": "USN-8582-1",
        "description": "Zeng Yunxiang and Song Jiaxuan discovered that jbig2dec had an out-of-bounds read vulnerability in its command-line tool. An attacker could possibly use this issue to cause jbig2dec to crash, resulting in a denial of service. This issue only affected Ubuntu 22.04 LTS. (CVE-2023-46361)  It was discovered that jbig2dec had an integer overflow in the jbig2_arith_iaid_ctx_new() function. An attacker could possibly use this issue to cause a denial of service. (CVE-2026-38076)",
        "aliases": [
          "CVE-2023-46361",
          "CVE-2026-38076"
        ]
      },
      "timestamp": "2026-07-21T17:41:35Z",
