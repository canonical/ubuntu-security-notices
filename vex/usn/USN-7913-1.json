    {
      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-7913-1",
        "name": "USN-7913-1",
        "description": "It was discovered that the stb library, included in MAME, had a  heap-based buffer overflow. An attacker could possibly use this issue  to crash the program or execute arbitrary code. (CVE-2018-16981)  It was discovered that the tinyexr library, included in MAME, had a heap- based buffer over-read  in the function DecodePixelData. An  attacker could possibly use this issue to expose sensitive information or crash the program. (CVE-2022-34300)  It was discovered that the expat library, included in MAME, had an integer-overflow in the function doProlog. An attacker could possibly use this issue to crash the program or execute arbitrary code. (CVE-2021-46143)",
        "aliases": [
          "CVE-2018-16981",
          "CVE-2021-46143",
          "CVE-2022-34300"
        ]
      },
