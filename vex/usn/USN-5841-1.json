    {
      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-5841-1",
        "name": "USN-5841-1",
        "description": "It was discovered that LibTIFF incorrectly handled certain malformed images. If a user or automated system were tricked into opening a specially crafted image, a remote attacker could crash the application, leading to a denial of service, or possibly execute arbitrary code with user privileges. This issue was only fixed in Ubuntu 14.04 ESM. (CVE-2019-14973, CVE-2019-17546, CVE-2020-35523, CVE-2020-35524, CVE-2022-3970)  It was discovered that LibTIFF was incorrectly acessing a data structure when processing data with the tiffcrop tool, which could lead to a heap buffer overflow. An attacker could possibly use this issue to cause a denial of service or execute arbitrary code. (CVE-2022-48281)",
        "aliases": [
          "CVE-2019-14973",
          "CVE-2019-17546",
          "CVE-2020-35523",
          "CVE-2020-35524",
          "CVE-2022-3970",
          "CVE-2022-48281"
        ]
