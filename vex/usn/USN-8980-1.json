    {
      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-8980-1",
        "name": "USN-8980-1",
        "description": "It was discovered that DMitry incorrectly handled long arguments, leading to a stack-based buffer overflow. An attacker could possibly use this issue to cause DMitry to crash, resulting in a denial of service, or possibly execute arbitrary code. (CVE-2017-7938)  It was discovered that DMitry incorrectly handled long lines in WHOIS responses, leading to a stack-based buffer overflow. A remote attacker could possibly use this issue to cause DMitry to crash, resulting in a denial of service, or possibly execute arbitrary code. (CVE-2020-14931)  It was discovered that DMitry contained a format string vulnerability. An attacker could possibly use this issue to cause DMitry to crash, resulting in a denial of service, or possibly execute arbitrary code. (CVE-2024-31837)",
        "aliases": [
          "CVE-2017-7938",
          "CVE-2020-14931",
          "CVE-2024-31837"
        ]
      },
