    {
      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-9124-1",
        "name": "USN-9124-1",
        "description": "It was discovered that RenderDoc did not properly verify array sizes when serialising strings, leading to an integer overflow. An attacker could possibly use this issue to cause a buffer overflow, resulting in a denial of service, or possibly execute arbitrary code. (CVE-2023-33863)  It was discovered that RenderDoc incorrectly handled certain socket reads, leading to an integer overflow. A remote attacker could possibly use this issue to cause a heap buffer overflow, resulting in a denial of service, or possibly execute arbitrary code. (CVE-2023-33864)  It was discovered that RenderDoc followed symbolic links when opening its log file in the /tmp/RenderDoc directory. A local attacker could possibly use this issue to escalate privileges. (CVE-2023-33865)",
        "aliases": [
          "CVE-2023-33863",
          "CVE-2023-33864",
          "CVE-2023-33865"
        ]
      },
