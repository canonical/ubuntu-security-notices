    {
      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-9194-1",
        "name": "USN-9194-1",
        "description": "Adam Bedard discovered that libXrender incorrectly handled certain responses from an X server, resulting in a heap buffer overflow. If a user were tricked into connecting to a malicious X server, an attacker could possibly use this issue to cause applications using libXrender to crash, resulting in a denial of service, or execute arbitrary code. (CVE-2026-88807)  Tobias Stoeckmann discovered that libXrender did not correctly validate lengths in responses from an X server. An attacker controlling an X server could possibly use these issues to cause applications using libXrender to crash, resulting in a denial of service, or execute arbitrary code. This update provides the fixes for Ubuntu 14.04 LTS. (CVE-2016-7949, CVE-2016-7950)",
        "aliases": [
          "CVE-2016-7949",
          "CVE-2016-7950",
          "CVE-2026-88807"
        ]
      },
      "timestamp": "2026-11-25T02:38:24Z",
