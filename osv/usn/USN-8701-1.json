{
  "schema_version": "1.7.0",
  "id": "USN-8701-1",
  "summary": "udisks2 vulnerability",
  "details": "It was discovered that UDisks did not correctly validate the caller\nidentity when handling the as-user option in the\norg.freedesktop.UDisks2.Filesystem.Mount() D-Bus method. A local attacker\nwith an active console session could possibly use this issue to mount\nfilesystems on behalf of arbitrary users, including privileged accounts,\nleading to local privilege escalation.",
