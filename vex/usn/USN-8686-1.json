      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-8686-1",
        "name": "USN-8686-1",
        "description": "It was discovered that primitive decoders in openCryptoki produced integer underflows when the encoded length was zero. An attacker could possibly use this issue to trigger out-of-bounds reads. (CVE-2026-40253)  It was discovered that openCryptoki incorrectly handled symlinks. An attacker in the token-group could possibly use this issue to achieve privilege  escalation or access sensitive information. (CVE-2026-23893)",
        "aliases": [
          "CVE-2026-23893",
          "CVE-2026-40253"
        ]
      },
      "timestamp": "2026-08-27T14:43:29Z",
