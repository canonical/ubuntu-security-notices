      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-7575-1",
        "name": "USN-7575-1",
        "description": "It was discovered that MuJS did not correctly handle try/finally statements, which could lead to a buffer overflow. An attacker could possibly use this issue to cause a denial of service or execute  arbitrary code. (CVE-2021-45005)  Han Zheng discovered that MuJS did not correctly handle recursion, which could lead to stack exhaustion. An attacker could possibly use this issue to cause a denial of service. (CVE-2022-30974)  Han Zheng discovered that MuJS did not correctly handle certain memory operations. An attacker could possibly use this issue to cause a denial of service. (CVE-2022-30975)",
        "aliases": [
          "CVE-2021-45005",
          "CVE-2022-30974",
          "CVE-2022-30975"
        ]
      },
