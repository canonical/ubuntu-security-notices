      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-8987-1",
        "name": "USN-8987-1",
        "description": "It was discovered that libuser did not properly validate the GECOS field when changing user information. A local attacker could possibly use this issue to corrupt the passwd file, resulting in a denial of service. (CVE-2015-3245)  It was discovered that libuser modified the passwd file in place when updating user information. A local attacker could possibly use this issue to cause an inconsistent file state, resulting in a denial of service, or possibly escalate privileges. (CVE-2015-3246)",
        "aliases": [
          "CVE-2015-3245",
          "CVE-2015-3246"
        ]
      },
