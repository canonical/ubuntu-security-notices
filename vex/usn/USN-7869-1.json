      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-7869-1",
        "name": "USN-7869-1",
        "description": "Hanno B\u00f6ck discovered that Raptor incorrectly handled memory operations when processing certain input files. An attacker could possibly use this issue to cause Raptor to crash, resulting in a denial of service. (CVE-2020-25713)  Pedro Ribeiro discovered that Raptor incorrectly handled parsing certain tuples. An attacker could possibly use this issue to cause Raptor to crash, resulting in a denial of service. (CVE-2024-57822)  Pedro Ribeiro discovered that Raptor incorrectly handled parsing certain turtles. An attacker could use this issue to cause Raptor to crash, resulting in a denial of service, or possibly execute arbitrary code. (CVE-2024-57823)",
        "aliases": [
          "CVE-2020-25713",
          "CVE-2024-57822",
          "CVE-2024-57823"
        ]
      },
