      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-8228-1",
        "name": "USN-8228-1",
        "description": "It was discovered that Exim incorrectly handled parsing malformed JSON in message headers. A remote attacker could possibly use this issue to execute arbitrary code. (CVE-2026-40685)  It was discovered that Exim incorrectly handled processing of UTF-8 trailing characters. A remote attacker could possibly use this issue to obtain sensitive information. (CVE-2026-40686)  It was discovered that Exim incorrectly handled SPA authenticator input. An authenticated user could possibly use this issue to execute arbitrary code. (CVE-2026-40687)",
        "aliases": [
          "CVE-2026-40685",
          "CVE-2026-40686",
          "CVE-2026-40687"
        ]
      },
