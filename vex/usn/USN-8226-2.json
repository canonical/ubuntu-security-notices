  "statements": [
    {
      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-8226-2",
        "name": "USN-8226-2",
        "description": "USN-8226-1 added a mitigation to kmod to disable loading the algif_aead module. This update adds the same mitigation to Ubuntu 14.04 LTS, Ubuntu 16.04 LTS, Ubuntu 18.04 LTS, and Ubuntu 20.04 LTS.  Original advisory details:  It was discovered that the Linux kernel algif_aead module contained a logic flaw allowing a local attacker to escalate privileges to root. This update to the kmod package disables loading the algif_aead module as a measure to mitigate the issue until kernel updates are made available.  See the following URL for more information https://ubuntu.com/blog/copy-fail-vulnerability-fixes-available",
        "aliases": []
      },
