      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-8979-1",
        "name": "USN-8979-1",
        "description": "It was discovered that the web UI in Deluge did not protect against cross- site request forgery. A remote attacker could possibly use this issue to trick a user into installing a malicious plugin, resulting in the execution of arbitrary code. (CVE-2017-7178)  It was discovered that the web UI in Deluge incorrectly handled certain requests. A remote attacker could possibly use this issue to read arbitrary files. (CVE-2017-9031)",
        "aliases": [
          "CVE-2017-7178",
          "CVE-2017-9031"
        ]
      },
