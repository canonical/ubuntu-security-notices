      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-8696-1",
        "name": "USN-8696-1",
        "description": "It was discovered that Bind incorrectly handled DNSSEC validation when a domain was covered by both NSEC and NSEC3 records with only one type having an RRSIG. A remote attacker could possibly use this issue to cause Bind to crash, resulting in a denial of service.",
        "aliases": [
          "CVE-2026-13204"
        ]
