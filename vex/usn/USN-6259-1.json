      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-6259-1",
        "name": "USN-6259-1",
        "description": "Jos Wetzels, Stanislav Dashevskyi, and Amine Amri discovered that Open-iSCSI incorrectly handled certain checksums for IP packets. An attacker could possibly use this issue to expose sensitive information. (CVE-2020-13987)  Jos Wetzels, Stanislav Dashevskyi, Amine Amri discovered that Open-iSCSI incorrectly handled certain parsing TCP MSS options. An attacker could possibly use this issue to cause a crash or cause unexpected behavior. (CVE-2020-13988)  Amine Amri and Stanislav Dashevskyi discovered that Open-iSCSI incorrectly handled certain TCP data. An attacker could possibly use this issue to expose sensitive information. (CVE-2020-17437)",
        "aliases": [
          "CVE-2020-13987",
          "CVE-2020-13988",
          "CVE-2020-17437"
        ]
      },
