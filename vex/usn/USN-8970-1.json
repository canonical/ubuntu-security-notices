    {
      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-8970-1",
        "name": "USN-8970-1",
        "description": "It was discovered that GVfs did not properly validate data returned by an SFTP server. A remote attacker could possibly use this issue to obtain sensitive information. (CVE-2026-84267)  It was discovered that GVfs did not properly validate the size of replies from an AFP server. A remote attacker could possibly use this issue to cause a denial of service. (CVE-2026-84269)  It was discovered that GVfs did not properly validate the size of data returned by an MTP device. An attacker with a malicious MTP device could possibly use this issue to cause a denial of service. (CVE-2026-84270)",
        "aliases": [
          "CVE-2026-84267",
          "CVE-2026-84269",
          "CVE-2026-84270"
        ]
      },
