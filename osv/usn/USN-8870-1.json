{
  "schema_version": "1.7.0",
  "id": "USN-8870-1",
  "summary": "aodh, watcher vulnerability",
  "details": "Chen YuXiang discovered that OpenStack Aodh did not correctly enforce\nproject scoping in its alarm list API and that the OpenStack Watcher\nwebhook trigger endpoint did not apply authorization. An attacker could\npossibly use this issue to access sensitive alarm metadata or trigger\nunauthorized action plans.",
