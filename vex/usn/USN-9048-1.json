      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-9048-1",
        "name": "USN-9048-1",
        "description": "Andrew Bartlett discovered that AWL did not properly generate session keys. A remote attacker could possibly use this issue to guess a session key and impersonate another user's session. (CVE-2020-11728)  It was discovered that AWL did not securely generate long-term session cookies. A remote attacker could possibly use this issue to guess a session cookie through a brute-force attack and gain access to another user's session. (CVE-2020-11729)",
        "aliases": [
          "CVE-2020-11728",
          "CVE-2020-11729"
        ]
      },
