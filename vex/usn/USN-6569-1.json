      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-6569-1",
        "name": "USN-6569-1",
        "description": "it was discovered that libclamunrar incorrectly handled directories when extracting RAR archives. A remote attacker could possibly use this issue to overwrite arbitrary files and execute arbitrary code. This issue only affected Ubuntu 20.04 LTS, Ubuntu 22.04 LTS, and Ubuntu 23.04. (CVE-2022-30333)  It was discovered that libclamunrar incorrectly validated certain structures when extracting RAR archives. A remote attacker could possibly use this issue to execute arbitrary code. (CVE-2023-40477)",
        "aliases": [
          "CVE-2022-30333",
          "CVE-2023-40477"
        ]
      },
