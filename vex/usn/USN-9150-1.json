    {
      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-9150-1",
        "name": "USN-9150-1",
        "description": "It was discovered that SWUpdate did not verify that a path was a directory before cleaning it up, leading to a race condition. A local attacker could possibly use this issue to escalate privileges or install untrusted content using a signed update. (CVE-2025-41259)  It was discovered that SWUpdate used untrusted certificates embedded in CMS signatures when building the certificate chain. An attacker holding a signing key from another intermediate certificate authority under the same root could possibly use this issue to install malicious updates. After this update, SWUpdate ignores certificates embedded in CMS signatures. This issue only affected Ubuntu 22.04 LTS and Ubuntu 26.04 LTS. (CVE-2026-109399)",
        "aliases": [
          "CVE-2025-41259",
          "CVE-2026-109399"
        ]
      },
      "timestamp": "2026-11-17T17:18:22Z",
