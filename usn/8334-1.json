{
  "action": "This update uses a new upstream release, which includes additional bug\nfixes. After a standard system update you need to restart any running Java\napplications to make all the necessary changes.",
  "cves": [
    "CVE-2026-34268",
    "CVE-2026-22007",
    "CVE-2026-22021",
    "CVE-2026-34282",
    "CVE-2026-22018",
    "CVE-2026-22008",
