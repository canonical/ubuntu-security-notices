      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-8979-2",
        "name": "USN-8979-2",
        "description": "USN-8979-1 fixed vulnerabilities in Deluge. Due to a packaging error, the fixes were not applied in the update for Ubuntu 16.04 LTS. This update fixes the problem.  Original advisory details:   It was discovered that the web UI in Deluge did not protect against  cross-site request forgery. A remote attacker could possibly use this  issue to trick a user into installing a malicious plugin, resulting in the  execution of arbitrary code. (CVE-2017-7178)   It was discovered that the web UI in Deluge incorrectly handled certain  requests. A remote attacker could possibly use this issue to read  arbitrary files. (CVE-2017-9031)",
        "aliases": [
          "CVE-2017-7178",
          "CVE-2017-9031"
        ]
      },
