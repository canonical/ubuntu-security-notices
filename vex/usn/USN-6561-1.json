      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-6561-1",
        "name": "USN-6561-1",
        "description": "Fabian B\u00e4umer, Marcus Brinkmann, J\u00f6rg Schwenk discovered that the SSH protocol was vulnerable to a prefix truncation attack. If a remote attacker was able to intercept SSH communications, extension negotiation messages could be truncated, possibly leading to certain algorithms and features being downgraded. This issue is known as the Terrapin attack. This update adds protocol extensions to mitigate this issue.",
        "aliases": [
          "CVE-2023-48795"
        ]
      },
