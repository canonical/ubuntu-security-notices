      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-8995-1",
        "name": "USN-8995-1",
        "description": "It was discovered that Yaws did not properly sanitize XML input in its WebDAV implementation. A remote attacker could possibly use this issue to perform XML external entity injection attacks. (CVE-2020-24379)  It was discovered that Yaws mishandled certain input when running CGI scripts. A remote attacker could possibly use this issue to execute arbitrary commands. (CVE-2020-24916)",
        "aliases": [
          "CVE-2020-24379",
          "CVE-2020-24916"
        ]
