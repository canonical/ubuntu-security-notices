    {
      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-8442-1",
        "name": "USN-8442-1",
        "description": "It was discovered that kitty incorrectly handled certain image data. An attacker able to write to the terminal's input could possibly use this issue to cause kitty to crash, resulting in a denial of service, or possibly execute arbitrary code. (CVE-2026-33633)  It was discovered that kitty incorrectly handled certain graphics commands. An attacker able to write escape sequences to a kitty terminal could possibly use this issue to cause kitty to crash, resulting in a denial of service, or possibly execute arbitrary code. (CVE-2026-33642)",
        "aliases": [
          "CVE-2026-33633",
          "CVE-2026-33642"
        ]
      },
