      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-9075-2",
        "name": "USN-9075-2",
        "description": "USN-9075-1 fixed a vulnerability in libjwt. Unfortunately, the update built the OpenSSL version of libjwt with the wrong library name, which caused applications using it to fail to start. The update also left the fix for CVE-2024-25189 incomplete in that version. This update fixes the problems.  We apologize for the inconvenience.  Original advisory details:   It was discovered that libjwt did not use a constant-time comparison when  verifying HMAC signatures. A remote attacker could possibly use this issue  to forge signatures through a timing side-channel attack and bypass  authentication.",
        "aliases": [
          "CVE-2024-25189"
        ]
      },
