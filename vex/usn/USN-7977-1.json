      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-7977-1",
        "name": "USN-7977-1",
        "description": "Ryota K discovered that Git LFS may leak login credentials in certain instances due to failing to check for URL-encoded characters. An attacker could possibly use this issue to learn sensitive information. (CVE-2024-53263)  It was discovered that Git LFS could have its git lfs checkout and git lfs pull commands abused to write to any file on a user's system. An attacker could possibly use this issue to execute arbitrary code. This issue was only addressed in Ubuntu 24.04 LTS and Ubuntu 25.10. (CVE-2025-26625)",
        "aliases": [
          "CVE-2024-53263",
          "CVE-2025-26625"
        ]
      },
