      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-9096-1",
        "name": "USN-9096-1",
        "description": "It was discovered that CairoSVG fetched external files referenced by SVG documents by default. If a user or automated system were tricked into converting a specially crafted SVG file, an attacker could possibly use this issue to perform server-side request forgery attacks or cause a denial of service. After this update, CairoSVG only fetches external files when the unsafe option is used.",
        "aliases": [
          "CVE-2023-27586"
        ]
      },
