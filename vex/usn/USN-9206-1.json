      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-9206-1",
        "name": "USN-9206-1",
        "description": "It was discovered that Guava did not correctly handle permissions for certain temporary directories. An attacker could possibly use this issue to read or modify sensitive information. This issue only affected Ubuntu 22.04 LTS. (CVE-2020-8908, CVE-2023-2976)  Kaya Emre Arikan discovered that Guava did not correctly handle deserializing certain data. If a user or automated system were tricked into opening a specially crafted file, an attacker could possibly use this issue to cause a denial of service. (CVE-2026-102554)",
        "aliases": [
          "CVE-2020-8908",
          "CVE-2023-2976",
          "CVE-2026-102554"
        ]
      },
      "timestamp": "2026-11-26T07:08:32Z",
