      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-4217-2",
        "name": "USN-4217-2",
        "description": "USN-4217-1 fixed several vulnerabilities in Samba. This update provides the corresponding update for Ubuntu 14.04 ESM.  Original advisory details:   Andreas Oster discovered that the Samba DNS management server incorrectly  handled certain records. An authenticated attacker could possibly use this  issue to crash Samba, resulting in a denial of service. (CVE-2019-14861)   Isaac Boukris discovered that Samba did not enforce the Kerberos  DelegationNotAllowed feature restriction, contrary to expectations.  (CVE-2019-14870)",
        "aliases": [
          "CVE-2019-14861",
          "CVE-2019-14870"
        ]
      },
      "timestamp": "2019-12-11T15:07:59Z",
