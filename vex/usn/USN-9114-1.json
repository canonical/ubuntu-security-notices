      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-9114-1",
        "name": "USN-9114-1",
        "description": "It was discovered that Minetest did not deserialize data in a restricted environment. A remote attacker could possibly use this issue to modify arbitrary item metadata or execute arbitrary code. (CVE-2022-24300)  It was discovered that Minetest did not properly validate certain inventory actions. A remote attacker could possibly use this issue to add or remove items from the inventories of other players. (CVE-2022-24301)",
        "aliases": [
          "CVE-2022-24300",
          "CVE-2022-24301"
        ]
      },
