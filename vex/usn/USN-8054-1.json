    {
      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-8054-1",
        "name": "USN-8054-1",
        "description": "It was discovered that DjVuLibre could be forced to execute a division by zero in certain instances. A remote attacker could possibly use this issue to cause applications to stop responding or crash, resulting in a denial of service. (CVE-2021-46312)  It was discovered that DjVuLibre incorrectly handled certain memory operations. If a user or automated system were tricked into processing a specially crafted DjVu file, a remote attacker could cause applications to stop responding or crash, resulting in a denial of service, or possibly execute arbitrary code. This issue only affected Ubuntu 16.04 LTS, Ubuntu 18.04 LTS, and Ubuntu 20.04 LTS. (CVE-2025-53367)",
        "aliases": [
          "CVE-2021-46312",
          "CVE-2025-53367"
        ]
      },
