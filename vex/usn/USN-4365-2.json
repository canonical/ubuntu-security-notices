      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-4365-2",
        "name": "USN-4365-2",
        "description": "USN-4365-1 fixed several vulnerabilities in Bind. This update provides the corresponding update for Ubuntu 12.04 ESM and 14.04 ESM.   Original advisory details:   Lior Shafir, Yehuda Afek, and Anat Bremler-Barr discovered that Bind  incorrectly limited certain fetches. A remote attacker could possibly use  this issue to cause Bind to consume resources, leading to a denial of  service, or possibly use Bind to perform a reflection attack.  (CVE-2020-8616)   Tobias Klein discovered that Bind incorrectly handled checking TSIG  validity. A remote attacker could use this issue to cause Bind to crash,  resulting in a denial of service, or possibly perform other attacks.  (CVE-2020-8617)",
        "aliases": [
          "CVE-2020-8616",
          "CVE-2020-8617"
        ]
      },
