      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-7877-1",
        "name": "USN-7877-1",
        "description": "It was discovered that libcupsfilters incorrectly handled certain malformed TIFF image files. A remote attacker could use this issue to cause libcupsfilters to crash, resulting in a denial of service, or possibly execute arbitrary code. (CVE-2025-57812)  It was discovered that libcupsfilters incorrectly handled certain malformed PDF document files. A remote attacker could use this issue to cause libcupsfilters to crash, resulting in a denial of service, or possibly execute arbitrary code. (CVE-2025-64503)",
        "aliases": [
          "CVE-2025-57812",
          "CVE-2025-64503"
        ]
      },
