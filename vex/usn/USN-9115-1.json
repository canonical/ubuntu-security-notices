      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-9115-1",
        "name": "USN-9115-1",
        "description": "It was discovered that Mini-XML used unbounded recursion when deleting and writing XML nodes. An attacker could possibly use these issues to cause Mini-XML to crash, resulting in a denial of service. These issues only affected Ubuntu 16.04 LTS. (CVE-2016-4570, CVE-2016-4571)  It was discovered that Mini-XML incorrectly handled certain floating point values when writing XML nodes, leading to a stack-based buffer overflow. An attacker could possibly use this issue to cause Mini-XML to crash, resulting in a denial of service, or possibly execute arbitrary code. (CVE-2018-20004)",
        "aliases": [
          "CVE-2016-4570",
          "CVE-2016-4571",
          "CVE-2018-20004"
        ]
      },
      "timestamp": "2026-11-17T00:51:50Z",
