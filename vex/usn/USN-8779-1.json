      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-8779-1",
        "name": "USN-8779-1",
        "description": "It was discovered that Bubblewrap incorrectly handled certain temporary directories. A local attacker could possibly use this issue to cause a denial of service or execute arbitrary code. This issue only affected Ubuntu 18.04 LTS. (CVE-2019-12439)  It was discovered that Bubblewrap incorrectly handled certain symlinks during sandbox setup. A local attacker could possibly use this issue to create files outside of the sandbox. (CVE-2026-87766)",
        "aliases": [
          "CVE-2019-12439",
          "CVE-2026-87766"
        ]
      },
