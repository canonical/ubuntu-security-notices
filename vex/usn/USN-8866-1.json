      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-8866-1",
        "name": "USN-8866-1",
        "description": "It was discovered that Redis did not properly manage memory when handling the TLS pending-data list. A remote attacker could possibly use this issue to execute arbitrary code. (CVE-2026-81934)  It was discovered that Redis incorrectly handled certain inputs when processing cluster bus packets. A remote attacker could possibly use this issue to expose sensitive information or cause a denial of service. This issue only affected Ubuntu 24.04 LTS and Ubuntu 26.04 LTS. (CVE-2026-92925)",
        "aliases": [
          "CVE-2026-81934",
          "CVE-2026-92925"
        ]
      },
      "timestamp": "2026-10-06T03:02:05Z",
