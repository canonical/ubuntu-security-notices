      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-5286-1",
        "name": "USN-5286-1",
        "description": "Milan Broz discovered that cryptsetup incorrectly handled LUKS2 reencryption recovery. An attacker with physical access to modify the encrypted device header may trigger the device to be unencrypted the next time it is mounted by the user.  On Ubuntu 20.04 LTS, this issue was fixed by disabling the online reencryption feature.",
        "aliases": [
          "CVE-2021-4122"
        ]
      },
