      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-6243-1",
        "name": "USN-6243-1",
        "description": "It was discovered that Graphite-Web incorrectly handled certain inputs. If a user or an automated system were tricked into opening a specially crafted input file, a remote attacker could possibly use this issue to perform server-side request forgery and obtain sensitive information. This issue only affected Ubuntu 16.04 LTS and Ubuntu 18.04 LTS. (CVE-2017-18638)  It was discovered that Graphite-Web incorrectly handled certain inputs. If a user or an automated system were tricked into opening a specially crafted input file, a remote attacker could possibly use this issue to perform  cross site scripting and obtain sensitive information. (CVE-2022-4728, CVE-2022-4729, CVE-2022-4730)",
        "aliases": [
          "CVE-2017-18638",
          "CVE-2022-4728",
          "CVE-2022-4729",
          "CVE-2022-4730"
        ]
      },
