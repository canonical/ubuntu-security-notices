      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-6334-1",
        "name": "USN-6334-1",
        "description": "Peter Wang discovered that atftp did not properly manage certain inputs. A remote attacker could send a specially crafted tftp request to the server to cause a crash. (CVE-2020-6097)   Andreas B. Mundt discovered that atftp did not properly manage certain inputs. A remote attacker could send a specially crafted tftp request to the server to cause a crash. (CVE-2021-41054)   Johannes Krupp discovered that atftp did not properly manage certain inputs. A remote attacker could send a specially crafted tftp request to the server and make the server to disclose /etc/group data. (CVE-2021-46671)",
        "aliases": [
          "CVE-2020-6097",
          "CVE-2021-41054",
          "CVE-2021-46671"
        ]
      },
