      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-4435-1",
        "name": "USN-4435-1",
        "description": "It was discovered that ClamAV incorrectly handled parsing ARJ archives. A remote attacker could possibly use this issue to cause ClamAV to crash, resulting in a denial of service. (CVE-2020-3327)  It was discovered that ClamAV incorrectly handled scanning malicious files. A local attacker could possibly use this issue to delete arbitrary files. (CVE-2020-3350)  It was discovered that ClamAV incorrectly handled parsing EGG archives. A remote attacker could possibly use this issue to cause ClamAV to crash, resulting in a denial of service. (CVE-2020-3481)",
        "aliases": [
          "CVE-2020-3327",
          "CVE-2020-3350",
          "CVE-2020-3481"
        ]
      },
