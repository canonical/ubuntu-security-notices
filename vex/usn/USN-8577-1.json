      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-8577-1",
        "name": "USN-8577-1",
        "description": "USN-8222-1 fixed a vulnerability in OpenSSH. This update provides the corresponding fix for Ubuntu 16.04 LTS.  Original advisory details:   Vladimir Tokarev discovered that OpenSSH incorrectly handled certificates  with the principal name containing a comma character when using user-trusted  CA keys in authorized_keys and an authorized_keys principals=\"\" option  that lists more than one principal. This could result in inappropriate  principal matching, contrary to expectations. (CVE-2026-35414)",
        "aliases": [
          "CVE-2026-35414"
        ]
      },
