      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-8299-1",
        "name": "USN-8299-1",
        "description": "It was discovered that Rclone incorrectly handled authorization in the remote control API. An attacker could possibly use this issue to obtain sensitive information. (CVE-2026-41176)  It was discovered that Rclone incorrectly handled backend instantiation via the remote control API. An attacker could possibly use this issue to execute arbitrary code. This issue only affected Ubuntu 24.04 LTS, Ubuntu 25.10 and Ubuntu 26.04 LTS. (CVE-2026-41179)",
        "aliases": [
          "CVE-2026-41176",
          "CVE-2026-41179"
        ]
      },
