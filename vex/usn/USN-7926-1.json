      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-7926-1",
        "name": "USN-7926-1",
        "description": "Kay discovered that OpenStack Keystone incorrectly handled the ec2tokens and s3tokens APIs. A remote attacker could possibly use this issue to obtain unauthorized access and escalate privileges. (CVE-2025-65073)  It was discovered that OpenStack Keystone only validated the first 72 bytes of an application secret. An attacker could possibly use this issue to bypass password complexity. (CVE-2021-3563)  It was discovered that OpenStack Keystone had a time lag before a token should be revoked by the security policy. A remote administrator could use this issue to maintain access for longer than expected. (CVE-2022-2447)",
        "aliases": [
          "CVE-2021-3563",
          "CVE-2022-2447",
          "CVE-2025-65073"
        ]
      },
