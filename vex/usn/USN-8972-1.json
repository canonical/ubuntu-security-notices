      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-8972-1",
        "name": "USN-8972-1",
        "description": "It was discovered that HAProxy incorrectly handled truncated HTTP/2 PING frames. A remote attacker could possibly use this issue to cause HAProxy to consume excessive CPU resources, leading to a denial of service. (CVE-2026-110353)  It was discovered that HAProxy incorrectly handled certain HTTP/1.1 chunked requests. A remote attacker could possibly use this issue to cause HAProxy to consume excessive CPU resources, leading to a denial of service. (CVE-2026-110354)",
        "aliases": [
          "CVE-2026-110353",
          "CVE-2026-110354"
        ]
      },
