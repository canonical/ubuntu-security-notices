      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-7881-1",
        "name": "USN-7881-1",
        "description": "Jinfeng Guo discovered that the Security component of OpenJDK 8 did not correctly handle certain representations of encoded strings. An unauthenticated remote attacker could possibly use this issue to modify files or leak sensitive information. (CVE-2025-53057)  Darius Bohni discovered that the JAXP component of OpenJDK 8 was vulnerable to a XML External Entity (XEE) attack. An unauthenticated remote attacker could possibly use this issue to modify files or leak sensitive information. (CVE-2025-53066)  In addition to security fixes, the updated packages contain bug fixes, new features, and possibly incompatible changes.  Please see the following for more information: https://openjdk.org/groups/vulnerability/advisories/2025-10-21",
        "aliases": [
          "CVE-2025-53057",
          "CVE-2025-53066"
        ]
      },
