{
  "schema_version": "1.7.0",
  "id": "USN-8867-1",
  "summary": "ceph vulnerability",
  "details": "It was discovered that the Ceph Object Gateway (RGW) SigV4 handler did not\nreject requests carrying x-amz-* headers that were absent from the signed\nheader set. An attacker holding a presigned URL could possibly use this issue to\nattach arbitrary unsigned x-amz-* headers that RGW would honor, allowing them to escalate\ntheir privileges beyond what the URL's signer intended.",
  "aliases": [],
  "upstream": [
    "UBUNTU-CVE-2026-54330"
