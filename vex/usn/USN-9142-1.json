      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-9142-1",
        "name": "USN-9142-1",
        "description": "It was discovered that Apache XML Security for Java incorrectly passed a configuration property when creating specific key elements. An attacker could possibly use this issue to abuse an XPath Transform and extract sensitive information. After this update, file: and http: URIs are only dereferenced when the org.apache.xml.security.allowUnsafeResourceResolving property is set.",
        "aliases": [
          "CVE-2021-40690"
        ]
      },
