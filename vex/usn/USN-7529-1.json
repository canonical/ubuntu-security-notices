      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-7529-1",
        "name": "USN-7529-1",
        "description": "It was discovered that Apache Tika can have an excessive memory usage by using a crafted or corrupt PSD file. An attacker could possibly use this issue to cause a denial of service. This issue only affected Ubuntu 20.04 LTS. (CVE-2020-1950, CVE-2020-1951)  It was discovered that Apache Tika incorrectly handled certain regular expressions. An attacker could possibly use this issue to cause a denial of service. (CVE-2022-30126, CVE-2022-30973, CVE-2022-33879)",
        "aliases": [
          "CVE-2020-1950",
          "CVE-2020-1951",
          "CVE-2022-30126",
          "CVE-2022-30973",
          "CVE-2022-33879"
