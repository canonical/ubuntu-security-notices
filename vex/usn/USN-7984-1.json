    {
      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-7984-1",
        "name": "USN-7984-1",
        "description": "Thomas Chauchefoin discovered that Pagure incorrectly handled symbolic links in Git repositories. A remote attacker could possibly use this issue to cause Pagure to expose files outside the intended repository boundaries. (CVE-2024-4981)  Thomas Chauchefoin discovered that Pagure did not properly sanitize path inputs. A remote attacker could possibly use this issue to read arbitrary files. (CVE-2024-4982)  Thomas Chauchefoin discovered that Pagure incorrectly handled symbolic links during repository archiving. A remote attacker could possibly use this issue to disclose local files on the server. (CVE-2024-47515)  Thomas Chauchefoin discovered that Pagure incorrectly handled certain inputs. A remote attacker could possibly use this issue to execute arbitrary code on the server. (CVE-2024-47516)",
        "aliases": [
          "CVE-2024-4981",
          "CVE-2024-4982",
          "CVE-2024-47515",
          "CVE-2024-47516"
        ]
      },
