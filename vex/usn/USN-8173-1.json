    {
      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-8173-1",
        "name": "USN-8173-1",
        "description": "It was discovered that polkit incorrectly handled nested elements in XML policy files. If an administrator were tricked into installing a malicious policy file, a remote attacker could possibly use this issue to cause polkit to crash, resulting in a denial of service. (CVE-2025-7519)  Pavel Kohout discovered that the polkit polkit-agent-helper-1 utility incorrectly handled long input. A local attacker could possibly use this issue to cause polkit to crash, resulting in a denial of service. (CVE-2026-4897)",
        "aliases": [
          "CVE-2025-7519",
          "CVE-2026-4897"
        ]
      },
