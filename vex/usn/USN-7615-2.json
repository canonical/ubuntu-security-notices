      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-7615-2",
        "name": "USN-7615-2",
        "description": "USN-7615-1 fixed several vulnerabilities in ClamAV. This update provides the corresponding update for Ubuntu 20.04 LTS.  Original advisory details:   It was discovered that ClamAV incorrectly handled scanning UDF files. A  remote attacker could possibly use this issue to cause ClamAV to crash,  resulting in a denial of service. (CVE-2025-20234)   It was discovered that ClamAV incorrectly handled scanning PDF files. A  remote attacker could use this issue to cause ClamAV to crash, resulting  in a denial of service, or possibly execute arbitrary code.  (CVE-2025-20260)",
        "aliases": [
          "CVE-2025-20234"
        ]
      },
