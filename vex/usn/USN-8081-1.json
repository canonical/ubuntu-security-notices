      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-8081-1",
        "name": "USN-8081-1",
        "description": "It was discovered that libpng did not properly handle memory when processing certain PNG files. An attacker could possibly use this issue to cause libpng to crash, resulting in a denial of service, or disclose sensitive information. (CVE-2025-64505)  Joshua Inscoe discovered that libpng did not properly handle memory when processing certain PNG files. An attacker could possibly use this issue to cause libpng to crash, resulting in a denial of service, disclose sensitive information, or execute arbitrary code. (CVE-2026-25646)",
        "aliases": []
      },
