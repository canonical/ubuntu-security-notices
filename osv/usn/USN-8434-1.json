{
  "schema_version": "1.7.0",
  "id": "USN-8434-1",
  "summary": "nova vulnerability",
  "details": "It was discovered that Nova did not strip internal _nova-prefixed\nscheduler hints supplied by users on instance creation. An attacker could\npossibly use this issue to bypass Placement resource claims and\nscheduling constraint enforcement.",
