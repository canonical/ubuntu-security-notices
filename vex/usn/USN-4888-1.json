      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-4888-1",
        "name": "USN-4888-1",
        "description": "Douglas Bagnall discovered that ldb, when used with Samba, incorrectly handled certain LDAP attributes. A remote attacker could possibly use this issue to cause the LDAP server to crash, resulting in a denial of service. (CVE-2021-20277)  Douglas Bagnall discovered that ldb, when used with Samba, incorrectly handled certain DN strings. A remote attacker could use this issue to cause the LDAP server to crash, resulting in a denial of service, or possibly execute arbitrary code. (CVE-2020-27840)",
        "aliases": [
          "CVE-2020-27840",
          "CVE-2021-20277"
        ]
      },
