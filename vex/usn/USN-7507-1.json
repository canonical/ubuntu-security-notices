      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-7507-1",
        "name": "USN-7507-1",
        "description": "It was discovered that Rack incorrectly handled deleted rack sessions. An attacker could possibly use this issue to expose sensitive information or to gain unauthorized access to user accounts. (CVE-2025-32441)  It was discovered that Rack incorrectly limited the number of parameters in a web request. An attacker could possibly use this issue to cause a denial of service. This issue only affected Ubuntu 20.04 LTS, Ubuntu 22.04 LTS, Ubuntu 24.04 LTS, Ubuntu 24.10, and Ubuntu 25.04. (CVE-2025-46727)",
        "aliases": [
          "CVE-2025-32441",
          "CVE-2025-46727"
        ]
      },
