      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-3048-1",
        "name": "USN-3048-1",
        "description": "Bru Rom discovered that curl incorrectly handled client certificates when resuming a TLS session. (CVE-2016-5419)  It was discovered that curl incorrectly handled client certificates when reusing TLS connections. (CVE-2016-5420)  Marcelo Echeverria and Fernando Mu\u00f1oz discovered that curl incorrectly reused a connection struct, contrary to expectations. This issue only applied to Ubuntu 14.04 LTS and Ubuntu 16.04 LTS. (CVE-2016-5421)",
        "aliases": [
          "CVE-2016-5419",
          "CVE-2016-5420",
          "CVE-2016-5421"
        ]
      },
