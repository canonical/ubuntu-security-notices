    {
      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-8542-1",
        "name": "USN-8542-1",
        "description": "Yiwei Hou discovered that Dnsmasq incorrectly handled logging of DS or DNSKEY. A remote attacker could possibly use this issue to cause a denial of service. (CVE-2026-12725)  It was discovered that Dnsmasq incorrectly validated the length of fixed-length DNS record fields when parsing NS section records. A remote attacker could possibly use this issue to cause Dnsmasq to read out of bounds, possibly exposing sensitive information. (CVE-2026-12969)",
        "aliases": [
          "CVE-2026-12725",
          "CVE-2026-12969"
        ]
      },
      "timestamp": "2026-07-14T17:43:48Z",
