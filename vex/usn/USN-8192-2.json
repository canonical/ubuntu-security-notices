      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-8192-2",
        "name": "USN-8192-2",
        "description": "USN-8192-1 fixed vulnerabilities in NTFS-3G. This update provides the corresponding update to Ubuntu 26.04 LTS.  Original advisory details:   Jeffrey Bencteux discovered that NTFS-3G incorrectly handled certain UTF-8  sequences. An attacker could use this issue to cause NTFS-3G to crash,  resulting in a denial of service, or to execute arbitrary code. This issue  only affected Ubuntu 22.04 LTS and Ubuntu 24.04 LTS. (CVE-2023-52890)   Andrea Bocchetti discovered that NTFS-3G incorrectly handled certain  security descriptors. An attacker could use this issue to cause NTFS-3G to  crash, resulting in a denial of service, or to execute arbitrary code.  (CVE-2026-40706)",
        "aliases": [
          "CVE-2026-40706"
        ]
      },
