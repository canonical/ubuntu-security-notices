      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-8736-2",
        "name": "USN-8736-2",
        "description": "USN-8736-1 fixed vulnerabilities in Perl. This update provides the corresponding fix for Perl on Ubuntu 24.04 LTS.  Original advisory details:  It was discovered that Perl incorrectly handled certain large inputs during regular expression matching. An attacker could possibly use this issue to trigger out-of-bounds heap reads or writes, resulting in a denial of service or arbitrary code execution. (CVE-2026-15534)  It was discovered that Perl incorrectly handled certain regular expression containing alternative matching branches. An attacker could  possibly use this issue to cause incorrect regular expression matches, resulting in security restrictions being bypassed. (CVE-2026-19487)",
        "aliases": [
          "CVE-2026-15534",
          "CVE-2026-19487"
        ]
      },
