      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-9212-1",
        "name": "USN-9212-1",
        "description": "It was discovered that PyJWT incorrectly handled errors when parsing deeply nested token headers. An attacker could possibly use this issue to cause applications using PyJWT to fail unexpectedly, resulting in a denial of service. (CVE-2026-102265)  It was discovered that PyJWT modified the options mapping supplied by an application when signature verification was disabled. If an application reused that mapping for a later call with signature verification enabled, an attacker could possibly use this issue to bypass token claim checks, such as expiration. This issue only affected Ubuntu 22.04 LTS. (CVE-2026-103001)",
        "aliases": [
          "CVE-2026-102265",
          "CVE-2026-103001"
        ]
      },
      "timestamp": "2026-11-26T14:45:08Z",
