    {
      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-8431-1",
        "name": "USN-8431-1",
        "description": "It was discovered that Ruby's Net::IMAP library did not properly verify that Transport Layer Security (TLS) encryption was started after issuing a STARTTLS command. A remote attacker could possibly use this issue to perform a machine-in-the-middle attack and silently bypass TLS encryption. (CVE-2026-42246)  It was also discovered that Ruby's Net::IMAP library did not validate string arguments passed to certain commands. A remote attacker could possibly use this issue to inject arbitrary IMAP commands. (CVE-2026-42257)",
        "aliases": [
          "CVE-2026-42246",
          "CVE-2026-42257"
        ]
      },
      "timestamp": "2026-06-15T17:24:17Z",
