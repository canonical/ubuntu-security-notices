    {
      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-8977-1",
        "name": "USN-8977-1",
        "description": "It was discovered that BitlBee incorrectly handled file transfer connections that expired when built with libpurple. A remote attacker could possibly use this issue to cause BitlBee to crash, resulting in a denial of service, or possibly execute arbitrary code. (CVE-2016-10188)  It was discovered that BitlBee incorrectly handled file transfer requests for contacts that were not in the contact list. A remote attacker could possibly use this issue to cause BitlBee to crash, resulting in a denial of service, or possibly execute arbitrary code. (CVE-2016-10189)",
        "aliases": [
          "CVE-2016-10188",
          "CVE-2016-10189"
        ]
      },
