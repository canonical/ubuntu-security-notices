      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-9116-1",
        "name": "USN-9116-1",
        "description": "It was discovered that the rcp client in rsh incorrectly handled filenames of . or empty filenames received from the server. If a user were tricked into connecting to a malicious rsh server, an attacker could possibly use this issue to modify the permissions of the target directory. (CVE-2019-7282)  It was discovered that the rcp client in rsh did not properly validate filenames received from the server. If a user were tricked into connecting to a malicious rsh server, an attacker could possibly use this issue to overwrite arbitrary files in the target directory. (CVE-2019-7283)",
        "aliases": [
          "CVE-2019-7282",
          "CVE-2019-7283"
        ]
      },
      "timestamp": "2026-11-17T00:47:47Z",
