    {
      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-9200-1",
        "name": "USN-9200-1",
        "description": "It was discovered that elfutils incorrectly handled memory when processing certain malformed DWARF data. If a user or automated system were tricked into running readelf on a specially crafted file, an attacker could possibly use this issue to cause readelf to crash, resulting in a denial of service, or execute arbitrary code. (CVE-2025-1352)  It was discovered that strip from elfutils could be made to dereference invalid memory when processing certain sections without data. If a user or automated system were tricked into running strip on a specially crafted file, an attacker could possibly use this issue to cause strip to crash, resulting in a denial of service. (CVE-2025-1376)",
        "aliases": [
          "CVE-2025-1352",
          "CVE-2025-1376"
        ]
      },
      "timestamp": "2026-11-25T18:52:08Z",
