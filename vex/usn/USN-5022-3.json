      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-5022-3",
        "name": "USN-5022-3",
        "description": "USN-5022-1 fixed several vulnerabilities in MySQL. This update provides the corresponding update for Ubuntu 16.04 ESM.  Original advisory details:   Multiple security issues were discovered in MySQL and this update includes  new upstream MySQL versions to fix these issues.   MySQL has been updated to MySQL 5.7.35 on Ubuntu 16.04 ESM.   In addition to security fixes, the updated packages contain bug fixes, new  features, and possibly incompatible changes.   Please see the following for more information:   https://dev.mysql.com/doc/relnotes/mysql/5.7/en/news-5-7-35.html  https://dev.mysql.com/doc/relnotes/mysql/8.0/en/news-8-0-26.html  https://www.oracle.com/security-alerts/cpujul2021.html",
        "aliases": []
      },
