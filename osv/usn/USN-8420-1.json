{
  "schema_version": "1.7.0",
  "id": "USN-8420-1",
  "summary": "dotnet8, dotnet9, dotnet10 vulnerabilities",
  "details": "It was discovered that .NET did not properly handle link resolution before\nfile access. A local attacker could use this issue to perform unauthorized\nfile tampering and write arbitrary files outside of the intended extraction\ndirectory. (CVE-2026-45491)\n\nIt was discovered that .NET did not properly handle deeply-nested\nMessagePack arrays. An attacker could use this to cause .NET to consume\nexcessive resources, resulting in a denial of service. (CVE-2026-45591)",
  "aliases": [],
  "upstream": [
    "UBUNTU-CVE-2026-45491",
    "UBUNTU-CVE-2026-45591"
  ],
