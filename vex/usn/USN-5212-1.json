      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-5212-1",
        "name": "USN-5212-1",
        "description": "It was discovered that the Apache HTTP Server incorrectly handled certain forward proxy requests. A remote attacker could use this issue to cause the server to crash, resulting in a denial of service, or possibly perform a Server Side Request Forgery attack. (CVE-2021-44224)  It was discovered that the Apache HTTP Server Lua module incorrectly handled memory in the multipart parser. A remote attacker could use this issue to cause the server to crash, resulting in a denial of service, or possibly execute arbitrary code. (CVE-2021-44790)",
        "aliases": [
          "CVE-2021-44224",
          "CVE-2021-44790"
        ]
      },
