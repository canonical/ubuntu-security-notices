      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-7439-1",
        "name": "USN-7439-1",
        "description": "It was discovered that QuickJS could be forced to reference uninitialized memory in certain instances. An attacker could possibly use this issue to cause QuickJS to crash, resulting in a denial of service, or execute arbitrary code. (CVE-2023-48183)  It was discovered that QuickJS incorrectly managed memory in certain circumstances. An attacker could possibly use this issue to exhaust system resources, resulting in a denial of service. (CVE-2023-48184)  It was discovered that QuickJS could be forced to crash due to a failing test. An attacker could possibly use this issue to cause a denial of service. (CVE-2024-33263)",
        "aliases": [
          "CVE-2023-48183",
          "CVE-2023-48184",
          "CVE-2024-33263"
        ]
      },
