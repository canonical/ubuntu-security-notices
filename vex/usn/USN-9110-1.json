      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-9110-1",
        "name": "USN-9110-1",
        "description": "Liao Xinxi discovered that Jackson incorrectly handled the deserialization of certain classes. An attacker could possibly use this issue to execute arbitrary code. (CVE-2017-7525)  It was discovered that the fix for CVE-2017-7525 was incomplete, as Jackson still allowed the deserialization of certain dangerous classes. An attacker could possibly use this issue to execute arbitrary code. (CVE-2017-15095)  It was discovered that Jackson incorrectly handled XML external entities. An attacker could possibly use this issue to obtain sensitive information or cause a denial of service. (CVE-2019-10172)",
        "aliases": [
          "CVE-2017-7525",
          "CVE-2017-15095",
          "CVE-2019-10172"
        ]
      },
      "timestamp": "2026-11-17T00:02:05Z",
