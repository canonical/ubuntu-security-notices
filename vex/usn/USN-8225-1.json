      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-8225-1",
        "name": "USN-8225-1",
        "description": "Jared Deckard discovered that Python marshmallow did not correctly handle hiding certain fields. An attacker could possibly use this issue to leak sensitive information. This issue only affected Ubuntu 18.04 LTS. (CVE-2018-17175)  It was discovered that Python marshmallow did not efficiently handle merging certain objects. An attacker could possibly use this issue to cause a denial of service. This issue only affected Ubuntu 20.04 LTS, Ubuntu 22.04 LTS, Ubuntu 24.04 LTS and Ubuntu 26.04 LTS. (CVE-2025-68480)",
        "aliases": [
          "CVE-2018-17175",
          "CVE-2025-68480"
        ]
      },
      "timestamp": "2026-04-30T02:19:38Z",
