      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-8023-1",
        "name": "USN-8023-1",
        "description": "It was discovered that Expat, contained within the xmltok library, incorrectly handled the initialization of parsers for external entities. An attacker could possibly use this issue to cause a denial of service. (CVE-2026-24515)  It was discovered that Expat, contained within the xmltok library, incorrectly handled integer calculations when allocating memory for XML tags. An attacker could possibly use this issue to cause a denial of service or execute arbitrary code. (CVE-2026-25210)",
        "aliases": [
          "CVE-2026-24515",
          "CVE-2026-25210"
        ]
      },
