      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-4247-1",
        "name": "USN-4247-1",
        "description": "It was discovered that python-apt would still use MD5 hashes to validate certain downloaded packages. If a remote attacker were able to perform a machine-in-the-middle attack, this flaw could potentially be used to install altered packages. (CVE-2019-15795)  It was discovered that python-apt could install packages from untrusted repositories, contrary to expectations. (CVE-2019-15796)",
        "aliases": [
          "CVE-2019-15795",
          "CVE-2019-15796"
        ]
      },
