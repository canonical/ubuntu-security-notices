{
  "schema_version": "1.7.0",
  "id": "USN-8808-1",
  "summary": "sqlparse vulnerabilities",
  "details": "It was discovered that SQL parse contained multiple algorithmic complexity\nflaws when parsing SQL statements with deeply nested parentheses, comments,\nor dollar-quoted string literals. An attacker could use this issue to cause\nSQL parse to consume excessive CPU resources, resulting in a denial of\nservice.",
