      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-8366-1",
        "name": "USN-8366-1",
        "description": "It was discovered that Luanti, when using LuaJIT, did not properly enforce Lua sandbox restrictions. An attacker could possibly use this issue to execute arbitrary code. (CVE-2026-40959)  It was discovered that Luanti did not properly restrict access to insecure environments. An attacker could possibly use this issue to obtain unintended access to the insecure environment or HTTP API. (CVE-2026-40960)",
        "aliases": [
          "CVE-2026-40959",
          "CVE-2026-40960"
        ]
      },
