      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-3887-1",
        "name": "USN-3887-1",
        "description": "Chris Moberly discovered that snapd versions 2.28 through 2.37 incorrectly validated and parsed the remote socket address when performing access controls on its UNIX socket. A local attacker could use this to access privileged socket APIs and obtain administrator privileges. On Ubuntu systems with snaps installed, snapd typically will have already automatically refreshed itself to snapd 2.37.1 which is unaffected.",
        "aliases": [
          "CVE-2019-7304"
        ]
      },
