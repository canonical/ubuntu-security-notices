    {
      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-9213-1",
        "name": "USN-9213-1",
        "description": "Adam Bedard discovered that libXi did not properly validate DEVICE_RESOLUTION replies from the X server, which could result in a heap buffer overflow. A remote attacker could possibly use this issue to cause applications using libXi to crash, resulting in a denial of service. (CVE-2026-109089)  Adam Bedard discovered that libXi did not properly allocate memory when handling DEVICE_ENABLE replies from the X server. A remote attacker could possibly use this issue to cause applications using libXi to crash, resulting in a denial of service. (CVE-2026-109090)  It was discovered that libXi did not properly validate class data in XI2 replies and events. A remote attacker could possibly use this issue to cause applications using libXi to crash, resulting in a denial of service. (CVE-2026-93542)  It was discovered that libXi did not properly validate class metadata in XI2 replies and events. A remote attacker could possibly use this issue to cause applications using libXi to crash, resulting in a denial of service. (CVE-2026-93543)",
        "aliases": [
          "CVE-2026-93542",
          "CVE-2026-93543",
          "CVE-2026-109089",
          "CVE-2026-109090"
        ]
      },
