      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-8795-1",
        "name": "USN-8795-1",
        "description": "Kai Aizen discovered that the Networking component of OpenJDK 17 did not correctly handle user authentication. A remote attacker could possibly use this issue to leak sensitive information. (CVE-2026-61308)  It was discovered that the JSSE component of OpenJDK 17 did not correctly handle user authentication. A remote attacker could possibly use this issue to cause a denial of service. (CVE-2026-70907)  It was discovered that the Security component of OpenJDK 17 did not correctly handle user authentication. A remote attacker could possibly use this issue to leak sensitive information. (CVE-2026-60589)",
        "aliases": [
          "CVE-2026-60589",
          "CVE-2026-61308",
          "CVE-2026-70907"
        ]
      },
