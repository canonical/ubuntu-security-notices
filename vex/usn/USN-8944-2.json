      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-8944-2",
        "name": "USN-8944-2",
        "description": "USN-8944-1 updated ca-certificates. This update provides the corresponding changes for Ubuntu 14.04 LTS, Ubuntu 16.04 LTS, Ubuntu 18.04 LTS, and Ubuntu 20.04 LTS by removing the \"emSign ECC Root CA - G3\" and \"Comodo AAA Services root\" CA certificates.  Original advisory details:   This update removes the \"emSign ECC Root CA - G3\" CA certificate due to  intermediate CA certificates being compromised.   In addition, in Ubuntu 22.04 LTS, Ubuntu 24.04 LTS, and Ubuntu 26.04 LTS,  the ca-certificates package contained outdated CA certificates. This  update refreshes the included certificates to those contained in the 2.90  version of the Mozilla certificate authority bundle.",
        "aliases": []
      },
