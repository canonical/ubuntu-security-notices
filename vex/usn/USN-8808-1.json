      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-8808-1",
        "name": "USN-8808-1",
        "description": "It was discovered that SQL parse contained multiple algorithmic complexity flaws when parsing SQL statements with deeply nested parentheses, comments, or dollar-quoted string literals. An attacker could use this issue to cause SQL parse to consume excessive CPU resources, resulting in a denial of service.",
