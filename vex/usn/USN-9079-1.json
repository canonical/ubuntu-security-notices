      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-9079-1",
        "name": "USN-9079-1",
        "description": "It was discovered that nfdump incorrectly handled certain input files, leading to a buffer overflow. If a user or automated system were tricked into processing a specially crafted file, an attacker could possibly use this issue to cause nfdump to crash or execute arbitrary code. (CVE-2019-1010057)  It was discovered that nfdump incorrectly handled certain IPFIX template withdrawal messages, leading to an integer overflow. A remote attacker could possibly use this issue to cause nfdump to crash, resulting in a denial of service. (CVE-2019-14459)",
        "aliases": [
          "CVE-2019-14459",
          "CVE-2019-1010057"
        ]
      },
