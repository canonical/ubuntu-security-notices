      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-4009-2",
        "name": "USN-4009-2",
        "description": "USN-4009-1 fixed several vulnerabilities in PHP. This update provides the corresponding update for Ubuntu 12.04 ESM and Ubuntu 14.04 ESM.  Original advisory details:   It was discovered that PHP incorrectly decoding certain MIME headers. A  remote attacker could possibly use this issue to cause PHP to crash,  resulting in a denial of service. (CVE-2019-11039)   It was discovered that PHP incorrectly handled certain exif tags in images.  A remote attacker could use this issue to cause PHP to crash, resulting in  a denial of service, or possibly execute arbitrary code. (CVE-2019-11040)",
        "aliases": [
          "CVE-2019-11039",
          "CVE-2019-11040"
        ]
      },
      "timestamp": "2019-06-05T17:11:06Z",
