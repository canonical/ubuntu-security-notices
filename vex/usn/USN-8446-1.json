      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-8446-1",
        "name": "USN-8446-1",
        "description": "It was discovered that GStreamer Bad Plugins incorrectly handled parsing H.266/VVC picture partition data. An attacker could use this issue to cause GStreamer Bad Plugins to crash, resulting in a denial of service, or possibly execute arbitrary code. (CVE-2026-53701)  It was discovered that GStreamer Bad Plugins incorrectly handled parsing H.265 buffering period metadata. An attacker could use this issue to cause GStreamer Bad Plugins to crash, resulting in a denial of service, or possibly execute arbitrary code. (CVE-2026-53702)",
        "aliases": [
          "CVE-2026-53701",
          "CVE-2026-53702"
        ]
      },
