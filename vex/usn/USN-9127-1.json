        "@id": "https://ubuntu.com/security/notices/USN-9127-1",
        "name": "USN-9127-1",
        "description": "It was discovered that Syntastic searched the current directory and its parents for checker configuration files. If a user were tricked into checking a file in a directory controlled by an attacker, the attacker could possibly use this issue to execute arbitrary code. After this update, Syntastic only reads checker configuration files that are named in the *_config_file options.",
        "aliases": [
          "CVE-2018-11319"
        ]
      },
