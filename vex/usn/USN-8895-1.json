      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-8895-1",
        "name": "USN-8895-1",
        "description": "It was discovered that Sudo did not properly handle time-based access restrictions when sudoers rules used NOTBEFORE or NOTAFTER with timestamps omitting the trailing timezone indicator. A local attacker could possibly use this issue to execute commands outside the intended time window by manipulating the TZ environment variable.",
        "aliases": [
          "CVE-2026-96512"
        ]
      },
