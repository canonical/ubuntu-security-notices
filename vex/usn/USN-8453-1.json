      "vulnerability": {
        "@id": "https://ubuntu.com/security/notices/USN-8453-1",
        "name": "USN-8453-1",
        "description": "It was discovered that Net::CIDR::Lite incorrectly validated IP address and CIDR mask inputs. An attacker could possibly use this issue to bypass IP access control lists. (CVE-2026-45190)  It was discovered that Net::CIDR::Lite incorrectly handled extraneous zero characters in CIDR mask values. An attacker could possibly use this issue to bypass IP access control lists. (CVE-2026-45191)",
        "aliases": [
          "CVE-2026-45190",
          "CVE-2026-45191"
        ]
      },
